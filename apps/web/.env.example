# Claude Agent SDK
ANTHROPIC_API_KEY=

# 服务端读取 GitHub 仓库（克隆、Wiki 生成），避免匿名 API 限流。
# 只在服务端配置，绝不能使用 NEXT_PUBLIC_ 前缀。
GITHUB_TOKEN=

# GitHub App / repository webhook 的 HMAC 签名密钥。
GITHUB_WEBHOOK_SECRET=

# 飞书自建应用（OAuth 登录）。重定向 URL 需在飞书开放平台配置：
# http://127.0.0.1:3000/api/auth/feishu/callback
FEISHU_APP_ID=
FEISHU_APP_SECRET=
